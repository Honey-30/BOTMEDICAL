# Environment Configuration for Agentic AI Project Management Assistant

# Application Settings
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database Configuration
# For development (SQLite)
DATABASE_URL=sqlite:///./project_management.db

# For production (Supabase PostgreSQL)
# DATABASE_URL=postgresql://user:password@db.host:5432/database_name
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# AI Service Configuration
# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face (Fallback)
HUGGING_FACE_API_KEY=your-hugging-face-api-key

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Configuration (Gmail SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# API Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# AI Configuration
CONFIDENCE_THRESHOLD=0.6
MAX_TASKS_PER_PROJECT=1000
MAX_PROJECTS_PER_USER=50

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000